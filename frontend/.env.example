# frontend/.env.example
#
# Bu faylı `.env` adıyla kopyala və lazımi dəyəri yaz.
#
# Development zamanı backend localhost:5000-də işləyir,
# vite.config.js-də onsuz da proxy var, ona görə bu opsiyaldır.
#
# Production-da (Electron) bu BOŞ qalmalıdır — backend eyni origin-də işləyir.

# VITE_API_URL=http://localhost:5000
